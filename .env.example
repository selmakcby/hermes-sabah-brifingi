# Bu dosyayı .env olarak kopyala ve doldur. .env git'e girmez.
#
# Hostinger Hermes şablonunda anahtarlar panelden girilir ve /opt/data/.env
# dosyasına yazılır; bu dosyayı elle düzenlemene gerek yok. Aşağıdakiler
# hangi anahtarın hangi isimle beklendiğini gösterir.

# Model sağlayıcı (Hermes paneli → Keys → Anthropic)
ANTHROPIC_API_KEY=

# Telegram (Hermes paneli → Channels → Telegram → Manual setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# X'ten veri çekme (Hermes paneli → Keys → custom key; Oxylabs AI Studio anahtarı)
OXYLABS=
